# —— LLM / Agent ——
API_KEY=your_llm_api_key
URL=https://api.example.com
MODEL=your-model-name

SILICONFLOW_API_KEY=your_siliconflow_api_key

# —— PDF 解析 ——
MINERU_TOKEN=your_mineru_token

# —— 本地 Embedding（BGE-M3）——
BGE_MODEL_PATH=/models/bge-m3
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# —— 评测（可选）——
RAGAS_API_KEY=
RAGAS_BASE_URL=
RAGAS_LLM_MODEL=
EVAL_USERNAME=meridian

# —— 服务 ——
PORT=8897
ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:8080,http://127.0.0.1:8080
ALLOW_PRIVATE_URLS=false

# —— 数据库 / Redis ——
DATABASE_URL=postgresql+asyncpg://your_user:your_password@localhost:5432/your_db
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
RAG_CACHE_TTL_SECONDS=600

# —— JWT ——
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=300
